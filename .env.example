# Aplicação
APP_NAME=estoque_api
APP_PORT=5000
NODE_ENV=production
CORS_ORIGIN=*
DATABASE_URL=mysql://estoque:<password>@localhost:3306/estoque

# Banco de dados
DB_EXTERNAL_PORT=5006
DB_INTERNAL_PORT=3306
DB_NAME=estoque
DB_USER=estoque
DB_PASSWORD=<password>
DB_ROOT_PASSWORD=<password>

# Imagem do banco
MARIADB_IMAGE=mariadb:11.4

# Persistência
DB_VOLUME=estoque_volume

#Ativar o Swagger (documentação da API)
ENABLE_SWAGGER=true